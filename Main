                particle.Orientation = Enum.ParticleOrientation.FacingCamera               particle.Color = ColorSequence.new({ColorSequenceKeypoint.new(0.000000, Color3.new(0.35,0.9,1)), ColorSequenceKeypoint.new(1.000000, Color3.new(0.25,.6,1))})
                particle.Drag = 0
